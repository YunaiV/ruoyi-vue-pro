### 请求 /iot/device/message/send 接口（属性上报）=> 成功
POST {{baseUrl}}/iot/device/message/send
Content-Type: application/json
tenant-id: {{adminTenantId}}
Authorization: Bearer {{token}}

{
  "deviceId": 25,
  "method": "thing.property.post",
  "params": {
    "width": 1,
    "height": "2",
    "oneThree": "3"
  }
}

### 请求 /iot/device/message/send 接口（属性设置：params 为可写属性的标识符与值）=> 成功
POST {{baseUrl}}/iot/device/message/send
Content-Type: application/json
tenant-id: {{adminTenantId}}
Authorization: Bearer {{token}}

{
  "deviceId": 25,
  "method": "thing.property.set",
  "params": {
    "width": 1
  }
}

### 请求 /iot/device/message/send 接口（服务调用）=> 成功
POST {{baseUrl}}/iot/device/message/send
Content-Type: application/json
tenant-id: {{adminTenantId}}
Authorization: Bearer {{token}}

{
  "deviceId": 25,
  "method": "thing.service.invoke",
  "params": {
    "identifier": "temperature",
    "inputParams": {
      "xx": "yy"
    }
  }
}

### 请求 /iot/device/message/send 接口（配置推送）=> 成功
POST {{baseUrl}}/iot/device/message/send
Content-Type: application/json
tenant-id: {{adminTenantId}}
Authorization: Bearer {{token}}

{
  "deviceId": 25,
  "method": "thing.config.push",
  "params": {
    "configId": "1",
    "configSize": 1024,
    "signMethod": "MD5",
    "sign": "d41d8cd98f00b204e9800998ecf8427e",
    "url": "http://example.com/config.json",
    "getType": "file"
  }
}

### 请求 /iot/device/message/send 接口（OTA 固件信息推送）=> 成功
POST {{baseUrl}}/iot/device/message/send
Content-Type: application/json
tenant-id: {{adminTenantId}}
Authorization: Bearer {{token}}

{
  "deviceId": 25,
  "method": "thing.ota.upgrade",
  "params": {
    "version": "1.0.0",
    "fileUrl": "http://example.com/firmware.bin",
    "fileSize": 1024,
    "fileDigestAlgorithm": "MD5",
    "fileDigestValue": "d41d8cd98f00b204e9800998ecf8427e"
  }
}

### 查询设备消息对分页 - 基础查询（设备编号25）
GET {{baseUrl}}/iot/device/message/pair-page?deviceId=25&pageNo=1&pageSize=10
Authorization: Bearer {{token}}
tenant-id: {{adminTenantId}}

### 查询设备消息对分页 - 按标识符过滤（identifier=eat）
GET {{baseUrl}}/iot/device/message/pair-page?deviceId=25&identifier=eat&pageNo=1&pageSize=10
Authorization: Bearer {{token}}
tenant-id: {{adminTenantId}}