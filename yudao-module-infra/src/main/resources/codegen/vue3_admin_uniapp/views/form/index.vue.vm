    ${column.javaField}: undefined,
#else
    ${column.javaField}:#if($column.nullable) undefined#elseif($javaType == "long" || $javaType == "integer" || $javaType == "short" || $javaType == "float" || $javaType == "double" || $javaType == "bigdecimal" || $javaType == "byte") 0#elseif($javaType == "boolean") false#else ''#end,
#end
#end
#end
  }
}

#end
#end
/** 校验主子表数据 */
function isEmptySubValue(value: unknown) {
  return value === undefined || value === null || value === ''
}

function validateSubTables() {
#foreach ($subTable in $subTables)
#set ($index = $foreach.count - 1)
#set ($subClassNameVar = $subClassNameVars.get($index))
#set ($subColumns = $subColumnsList.get($index))
#set ($subJoinColumn = $subJoinColumns.get($index))
#if ($subTable.subJoinMany)
  for (let index = 0; index < ${subClassNameVar}s.value.length; index++) {
    const item = ${subClassNameVar}s.value[index]!
#foreach ($column in $subColumns)
#set ($javaFieldLower = $column.javaField.toLowerCase())
#if (($column.createOperation || $column.updateOperation) && !$column.nullable && !$column.primaryKey
          && $column.id != $subJoinColumn.id && $javaFieldLower != "createtime" && $javaFieldLower != "updatetime")
    if (isEmptySubValue(item.${column.javaField})) {
      toast.warning(`${subTable.classComment}第#[[${]]#index + 1#[[}]]#项的${column.columnComment}不能为空`)
      return false
    }
#end
#end
  }
#else
  if (${subClassNameVar}.value) {
#foreach ($column in $subColumns)
#set ($javaFieldLower = $column.javaField.toLowerCase())
#if (($column.createOperation || $column.updateOperation) && !$column.nullable && !$column.primaryKey
          && $column.id != $subJoinColumn.id && $javaFieldLower != "createtime" && $javaFieldLower != "updatetime")
    if (isEmptySubValue(${subClassNameVar}.value.${column.javaField})) {
      toast.warning('${subTable.classComment}的${column.columnComment}不能为空')
      return false
    }
#end
#end
  }
#end
#end
  return true
}

#end
/** 返回上一页 */
function handleBack() {
  navigateBackPlus('/pages-${table.moduleName}/${table.businessName}/index')
}

/** 加载${table.classComment}详情 */
async function getDetail() {
  if (!props.id) {
    return
  }
#if ($table.templateType == 10 || $table.templateType == 12)
  const [data#foreach ($subTable in $subTables)#set ($index = $foreach.count - 1), ${subClassNameVars.get($index)}Data#end] = await Promise.all([
    get${simpleClassName}(props.id),
#foreach ($subTable in $subTables)
#set ($index = $foreach.count - 1)
#set ($subSimpleClassName = $subSimpleClassNames.get($index))
#set ($subJoinColumn = $subJoinColumns.get($index))
#set ($SubJoinColumnName = $subJoinColumn.javaField.substring(0,1).toUpperCase() + $subJoinColumn.javaField.substring(1))
#if ($subTable.subJoinMany)
    get${subSimpleClassName}ListBy${SubJoinColumnName}(props.id),
#else
    get${subSimpleClassName}By${SubJoinColumnName}(props.id),
#end
#end
  ])
  formData.value = data
#foreach ($subTable in $subTables)
#set ($index = $foreach.count - 1)
#set ($subClassNameVar = $subClassNameVars.get($index))
#if ($subTable.subJoinMany)
  ${subClassNameVar}s.value = ${subClassNameVar}Data || []
#else
  ${subClassNameVar}.value = ${subClassNameVar}Data || null
#end
#end
#else
  formData.value = await get${simpleClassName}(props.id)
#end
}

/** 提交表单 */
async function handleSubmit() {
  const { valid } = await formRef.value.validate()
  if (!valid) {
    return
  }
#if ($table.templateType == 10 || $table.templateType == 12)
  if (!validateSubTables()) {
    return
  }
#end

  formLoading.value = true
  try {
#if ($table.templateType == 10 || $table.templateType == 12)
    const data = {
      ...formData.value,
#foreach ($subTable in $subTables)
#set ($index = $foreach.count - 1)
#set ($subClassNameVar = $subClassNameVars.get($index))
      ${subClassNameVar}#if($subTable.subJoinMany)s#end: ${subClassNameVar}#if($subTable.subJoinMany)s#end.value,
#end
    } as ${simpleClassName}
#else
    const data = formData.value as ${simpleClassName}
#end
    if (props.id) {
      await update${simpleClassName}(data)
      toast.success('修改成功')
    } else {
      await create${simpleClassName}(data)
      toast.success('新增成功')
    }
    uni.$emit('${table.moduleName}:${table.businessName}:reload')
    delay(handleBack)
  } finally {
    formLoading.value = false
  }
}

/** 初始化 */
onMounted(async () => {
#if ($table.templateType == 2)
  const data = await get${simpleClassName}List()
  treeData.value = [{
    ${primaryColumn.javaField}: 0,
    ${treeNameColumn.javaField}: '顶级${table.classComment}',
    ${treeParentColumn.javaField}: 0,
    children: handleTree(data, '${primaryColumn.javaField}', '${treeParentColumn.javaField}'),
  } as ${simpleClassName}]
#end
  getDetail()
})
</script>

