# 复制为 .env 后填写；.env 已被 .gitignore 忽略，勿提交真实凭据
# 必须与后端 yudao.im.rtc.api-key / yudao.im.rtc.api-secret 一致，网关用它校验后端签发的房间 Token
LIVEKIT_API_KEY=replace-with-api-key
LIVEKIT_API_SECRET=replace-with-secret-at-least-32-chars

# 网关试验开关：默认 false，网关容器打印说明后退出
MP_GATEWAY_ENABLED=false

# 后端 webhook（host 网络下容器可直接访问宿主机回环）
MP_LIVEKIT_WEBHOOK_URL=http://127.0.0.1:48080/admin-api/im/livekit/webhook

# 本机回环联调保持 127.0.0.1；真机联调改为手机可达的主机名 / IP，并同步放开对应监听与防火墙
MP_LIVEKIT_BIND_ADDRESS=127.0.0.1
MP_LIVEKIT_NODE_IP=127.0.0.1
MP_INGRESS_RTMP_PUBLIC_HOST=127.0.0.1
MP_SRS_PLAY_PUBLIC_HOST=127.0.0.1
MP_GATEWAY_API_HOST=127.0.0.1

# 资源上限：每个小程序会话 1 路 Ingress 转码，每个远端 1 路 Egress 转码
MP_GATEWAY_MAX_SESSIONS=4
MP_GATEWAY_MAX_EGRESS=8

# 网关专用 SRS app（yudao-mp-gw 或 yudao-mp-gw-<后缀>），该 app 只能给网关使用
# MP_GATEWAY_SRS_APP=yudao-mp-gw

# 其它可调参数，含义与默认值见 README「4. 配置」；不配置即使用默认值
# MP_GATEWAY_POLL_INTERVAL_MS=2000
# MP_GATEWAY_LEASE_TTL_MS=20000
# MP_GATEWAY_MAX_SESSION_MS=7200000
# MP_GATEWAY_MAX_REMOTES_PER_SESSION=4
# MP_GATEWAY_EGRESS_RETRY_MS=10000
# MP_GATEWAY_EGRESS_PUBLISH_TIMEOUT_MS=20000
# MP_GATEWAY_RELEASE_RETRY_MS=5000
# MP_GATEWAY_CLEANUP_RETRY_MS=5000
# MP_GATEWAY_REQUEST_TIMEOUT_MS=10000
# MP_GATEWAY_CLOCK_SKEW_SEC=30
# MP_GATEWAY_EGRESS_WIDTH=640
# MP_GATEWAY_EGRESS_HEIGHT=360
# MP_GATEWAY_EGRESS_FRAMERATE=15
# MP_GATEWAY_EGRESS_VIDEO_KBPS=600
# MP_GATEWAY_EGRESS_AUDIO_KBPS=64
# MP_GATEWAY_EGRESS_KEYFRAME_SEC=1
