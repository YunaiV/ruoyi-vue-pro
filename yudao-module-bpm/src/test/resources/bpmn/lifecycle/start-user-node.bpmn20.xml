<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.yudao.iocoder.cn/bpm">
    <!-- 发起人节点（StartUserNode）首次自动通过 -->
    <process id="startUserNode" name="发起人节点" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow id="flow-start" sourceRef="start" targetRef="StartUserNode"/>
        <userTask id="StartUserNode" name="发起人">
            <extensionElements>
                <flowable:candidateStrategy>36</flowable:candidateStrategy>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flow-start-user" sourceRef="StartUserNode" targetRef="task"/>
        <userTask id="task" name="审批">
            <extensionElements>
                <flowable:candidateStrategy>30</flowable:candidateStrategy>
            </extensionElements>
        </userTask>
        <sequenceFlow id="flow-task" sourceRef="task" targetRef="end"/>
        <endEvent id="end"/>
    </process>
</definitions>
