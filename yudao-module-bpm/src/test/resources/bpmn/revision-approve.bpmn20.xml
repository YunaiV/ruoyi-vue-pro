<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn" targetNamespace="http://www.yudao.iocoder.cn/bpm">
    <process id="revisionApprove" name="退回修改审批" isExecutable="true">
        <startEvent id="start"/>
        <sequenceFlow id="s1" sourceRef="start" targetRef="StartUserNode"/>
        <userTask id="StartUserNode" name="发起人">
            <extensionElements><flowable:candidateStrategy>30</flowable:candidateStrategy></extensionElements>
        </userTask>
        <sequenceFlow id="s2" sourceRef="StartUserNode" targetRef="approve"/>
        <userTask id="approve" name="审批">
            <extensionElements>
                <flowable:candidateStrategy>30</flowable:candidateStrategy>
                <flowable:returnApproveMode>2</flowable:returnApproveMode>
            </extensionElements>
        </userTask>
        <sequenceFlow id="s3" sourceRef="approve" targetRef="end"/>
        <endEvent id="end"/>
    </process>
</definitions>
